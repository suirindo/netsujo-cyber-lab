{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://netsujo.jp/projects/agent-os",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://netsujo.jp/projects/agent-os",
      "permanent": true
    }
  ]
}
